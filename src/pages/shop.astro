---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';

const filters = ['Усі', 'Шеврони', 'Одяг', 'Аксесуари'];

const products = [
  { src: '/images/shop-1.png', title: 'Набір брендових нашивок', category: 'Шеврони', price: '250 грн' },
  { src: '/images/shop-4.png', title: 'Нашивка "Прапор України"', category: 'Шеврони', price: '150 грн' },
  { src: '/images/shop-3.png', title: 'Худі з золотою емблемою', category: 'Одяг', price: '1 450 грн' },
  { src: '/images/shop-2.png', title: 'Джинсова куртка з вишивкою', category: 'Одяг', price: '2 300 грн' },
  { src: '/images/shop-6.png', title: 'Шопер з вишитим тризубом', category: 'Аксесуари', price: '650 грн' },
  { src: '/images/shop-5.png', title: 'Сорочка з монограмою на манжеті', category: 'Одяг', price: '1 200 грн' },
];
---

<Layout
  title="Магазин — ГАПТА | Готові вишиті вироби"
  description="Готові вироби студії ГАПТА: шеврони з тризубом від 150 грн, худі з вишивкою, джинсові куртки, шопери та сорочки з монограмою. Замовлення онлайн, виготовлення 1–3 дні."
>
  <Header />
  <main>
    <PageHero
      image="/images/shop-1.png"
      overline="Готові вироби"
      title="Магазин"
      crumb="Магазин"
    />

    <section class="shop">
      <div class="container">
        <div class="chips shop__filters" role="group" aria-label="Фільтр товарів за категоріями">
          {
            filters.map((f, i) => (
              <button
                type="button"
                class:list={['chip', { 'chip--active': i === 0 }]}
                data-filter={f === 'Усі' ? 'all' : f}
              >
                {f}
              </button>
            ))
          }
        </div>

        <div class="shop__grid">
          {
            products.map((p) => (
              <article class="product-card" data-category={p.category}>
                <div class="product-card__media">
                  <img src={p.src} alt={p.title} loading="lazy" />
                </div>
                <div class="product-card__body">
                  <span class="product-card__category">{p.category}</span>
                  <h2 class="product-card__title">{p.title}</h2>
                  <div class="product-card__footer">
                    <span class="product-card__price">{p.price}</span>
                    <a href="/order" class="btn btn--navy product-card__btn">Замовити</a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <div class="shop__custom">
          <div class="shop__custom-text">
            <p class="overline">Індивідуальне замовлення</p>
            <h2 class="shop__custom-title">Не знайшли потрібне? Виготовимо за вашим макетом.</h2>
          </div>
          <a href="/order" class="btn btn--gold">
            Отримати розрахунок
            <svg width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M0 6h16M11 1l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .shop {
    padding: 64px 0 88px;
  }

  .shop__filters {
    margin-bottom: 36px;
  }

  .shop__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 2px;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 38px rgba(20, 33, 61, 0.14);
    border-color: rgba(196, 162, 101, 0.5);
  }

  .product-card__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--cream-dark);
  }

  .product-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .product-card:hover .product-card__media img {
    transform: scale(1.04);
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 22px 24px;
    flex-grow: 1;
  }

  .product-card__category {
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--gold);
  }

  .product-card__title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--navy);
    line-height: 1.3;
  }

  .product-card__footer {
    margin-top: auto;
    padding-top: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .product-card__price {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--navy);
    white-space: nowrap;
  }

  .product-card__btn {
    padding: 12px 20px;
    font-size: 0.66rem;
  }

  .shop__custom {
    margin-top: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 40px 44px;
    background: var(--navy);
    border-radius: 2px;
  }

  .shop__custom-title {
    margin-top: 10px;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 600;
    color: #fff;
    line-height: 1.25;
  }

  @media (max-width: 900px) {
    .shop__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .shop {
      padding: 48px 0 64px;
    }

    .shop__grid {
      grid-template-columns: 1fr;
    }

    .shop__custom {
      flex-direction: column;
      align-items: flex-start;
      padding: 32px 24px;
    }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('chip--active'));
      chip.classList.add('chip--active');
      const filter = chip.dataset.filter;
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>
