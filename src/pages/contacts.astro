---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';

const contacts = [
  {
    label: 'Адреса',
    value: 'м. Рівне, вул. Котляревського, 2а',
    href: undefined,
    icon: 'pin',
  },
  {
    label: 'Телефон',
    value: '+38 (067) 907 99 80',
    href: 'tel:+380679079980',
    icon: 'phone',
  },
  {
    label: 'Телефон',
    value: '+38 (093) 287 60 80',
    href: 'tel:+380932876080',
    icon: 'phone',
  },
  {
    label: 'Сайт',
    value: 'gapta.com.ua',
    href: 'https://gapta.com.ua',
    icon: 'globe',
  },
];

const socials = [
  { name: 'Instagram', href: 'https://www.instagram.com/gapta.rv/', icon: 'instagram' },
  { name: 'Facebook', href: '/', icon: 'facebook', internal: true },
  { name: 'Telegram', href: 'https://t.me/ksanamayska', icon: 'telegram' },
];
---

<Layout
  title="Контакти — ГАПТА | Студія машинної вишивки в Рівному"
  description="Зв'яжіться зі студією машинної вишивки ГАПТА: м. Рівне, вул. Котляревського, 2а, +38 (067) 907 99 80, +38 (093) 287 60 80. Працюємо Пн–Пт 9:00–18:00. Відповідаємо протягом робочого дня."
>
  <Header />
  <main>
    <PageHero
      image="/images/cta-left.png"
      overline="Зв'яжіться з нами"
      title="Контакти"
      crumb="Контакти"
    />

    <section class="contacts">
      <div class="container contacts__grid">
        <div class="contacts__info">
          <ul class="contacts__cards">
            {
              contacts.map((c) => (
                <li class="contact-card">
                  <span class="contact-card__icon" aria-hidden="true">
                    {c.icon === 'pin' && (
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
                        <path d="M10 18s-6.5-5.3-6.5-9.5a6.5 6.5 0 0 1 13 0C16.5 12.7 10 18 10 18Z" stroke-linejoin="round" />
                        <circle cx="10" cy="8.3" r="2.3" />
                      </svg>
                    )}
                    {c.icon === 'phone' && (
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
                        <path d="M4.5 3h3.4l1.4 3.8-2.1 1.6a12 12 0 0 0 4.9 4.9l1.6-2.1 3.8 1.4v3.4a1.7 1.7 0 0 1-1.8 1.7C8.2 17.7 2.3 11.8 2.3 4.8A1.7 1.7 0 0 1 4.5 3Z" stroke-linejoin="round" />
                      </svg>
                    )}
                    {c.icon === 'email' && (
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
                        <rect x="2" y="4" width="16" height="12" rx="2" />
                        <path d="M2.6 5.6L10 11l7.4-5.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                    {c.icon === 'globe' && (
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
                        <circle cx="10" cy="10" r="7.5" />
                        <path d="M2.5 10h15M10 2.5c2.1 2 3.2 4.6 3.2 7.5s-1.1 5.5-3.2 7.5c-2.1-2-3.2-4.6-3.2-7.5S7.9 4.5 10 2.5Z" />
                      </svg>
                    )}
                  </span>
                  <span class="contact-card__body">
                    <span class="contact-card__label">{c.label}</span>
                    {c.href ? (
                      <a href={c.href} class="contact-card__value" target={c.icon === 'globe' ? '_blank' : undefined} rel={c.icon === 'globe' ? 'noopener' : undefined}>
                        {c.value}
                      </a>
                    ) : (
                      <span class="contact-card__value">{c.value}</span>
                    )}
                  </span>
                </li>
              ))
            }
          </ul>

          <div class="contacts__hours">
            <h2 class="contacts__hours-heading">Працюємо</h2>
            <ul class="contacts__hours-list">
              <li><span class="contacts__day">Пн–Пт:</span> 9:00 – 18:00</li>
              <li><span class="contacts__day">Сб:</span> за домовленістю</li>
              <li><span class="contacts__day">Нд:</span> вихідний</li>
            </ul>
          </div>

          <div class="contacts__socials">
            {
              socials.map((s) => (
                <a href={s.href} class="contacts__social" aria-label={s.name} target={s.internal ? undefined : '_blank'} rel="noopener">
                  {s.icon === 'instagram' && (
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
                      <rect x="2" y="2" width="16" height="16" rx="4.5" />
                      <circle cx="10" cy="10" r="3.8" />
                      <circle cx="14.6" cy="5.4" r="0.9" fill="currentColor" stroke="none" />
                    </svg>
                  )}
                  {s.icon === 'facebook' && (
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
                      <path d="M12.5 3.5h-2a3 3 0 0 0-3 3V9H5v3h2.5v5.5h3V12H13l.7-3h-3.2V6.7c0-.6.4-1 1-1h2V3.5Z" stroke-linejoin="round" />
                    </svg>
                  )}
                  {s.icon === 'telegram' && (
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
                      <path d="M17.5 3.5L2.8 9.2c-.9.35-.8 1.6.2 1.85l3.7 1 1.4 4.3c.3.85 1.4 1 1.95.3l2.1-2.7 3.4 2.5c.7.5 1.7.15 1.9-.7l2.4-11.2c.2-1-.9-1.8-1.85-1.35Z" stroke-linejoin="round" />
                      <path d="M7.9 12.05l8-7.05" stroke-linecap="round" />
                    </svg>
                  )}
                  {s.icon === 'email' && (
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
                      <rect x="2" y="4" width="16" height="12" rx="2" />
                      <path d="M2.5 5.5L10 11l7.5-5.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                </a>
              ))
            }
          </div>
        </div>

        <div class="contacts__form-wrap">
          <h2 class="contacts__form-title">Напишіть нам</h2>
          <form class="contacts__form" action="#" method="post">
            <div class="field">
              <label class="field__label" for="contacts-name">Ім'я <sup>*</sup></label>
              <input class="field__input" type="text" id="contacts-name" name="name" required autocomplete="name" placeholder="Ваше ім'я" />
            </div>
            <div class="field">
              <label class="field__label" for="contacts-phone">Телефон <sup>*</sup></label>
              <input class="field__input" type="tel" id="contacts-phone" name="phone" required autocomplete="tel" placeholder="+38 (___) ___ __ __" />
            </div>
            <div class="field">
              <label class="field__label" for="contacts-email">Email</label>
              <input class="field__input" type="email" id="contacts-email" name="email" autocomplete="email" placeholder="you@example.com" />
            </div>
            <div class="field">
              <label class="field__label" for="contacts-message">Повідомлення</label>
              <textarea class="field__textarea" id="contacts-message" name="message" placeholder="Опишіть вашу ідею або запитання"></textarea>
            </div>
            <button type="submit" class="btn btn--navy contacts__submit">Надіслати повідомлення</button>
            <p class="contacts__form-note">Відповідаємо протягом робочого дня</p>
          </form>
        </div>
      </div>
    </section>

    <section class="map" aria-label="Мапа: м. Рівне, вул. Котляревського, 2а">
      <div class="map__pin" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M16 29S6.5 20.5 6.5 13.5a9.5 9.5 0 0 1 19 0C25.5 20.5 16 29 16 29Z" stroke-linejoin="round" />
          <circle cx="16" cy="13.2" r="3.4" />
        </svg>
      </div>
      <p class="map__label">м. Рівне, вул. Котляревського, 2а</p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .contacts {
    padding: 80px 0 88px;
  }

  .contacts__grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 64px;
    align-items: start;
  }

  .contacts__cards {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 22px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 2px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .contact-card:hover {
    border-color: rgba(196, 162, 101, 0.55);
    box-shadow: 0 12px 28px rgba(20, 33, 61, 0.08);
    transform: translateY(-2px);
  }

  .contact-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border: 1px solid rgba(196, 162, 101, 0.45);
    border-radius: 50%;
    color: var(--gold);
  }

  .contact-card__icon svg {
    width: 20px;
    height: 20px;
  }

  .contact-card__body {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .contact-card__label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
  }

  .contact-card__value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--navy);
    transition: color 0.2s ease;
  }

  a.contact-card__value:hover {
    color: var(--gold);
  }

  .contacts__hours {
    margin-top: 32px;
    padding: 24px 26px;
    background: var(--navy);
    border-radius: 2px;
  }

  .contacts__hours-heading {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gold);
    margin-bottom: 16px;
  }

  .contacts__hours-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.78);
  }

  .contacts__day {
    color: #fff;
    font-weight: 600;
  }

  .contacts__socials {
    display: flex;
    gap: 12px;
    margin-top: 28px;
  }

  .contacts__social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(20, 33, 61, 0.25);
    border-radius: 50%;
    color: var(--navy);
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .contacts__social svg {
    width: 17px;
    height: 17px;
  }

  .contacts__social:hover {
    color: #fff;
    background: var(--gold);
    border-color: var(--gold);
  }

  .contacts__form-wrap {
    padding: 40px 38px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 2px;
  }

  .contacts__form-title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 26px;
  }

  .contacts__form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .contacts__submit {
    justify-content: center;
    margin-top: 4px;
  }

  .contacts__form-note {
    font-size: 0.76rem;
    color: var(--muted);
    text-align: center;
  }

  .map {
    height: 360px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    background:
      radial-gradient(circle at 50% 42%, rgba(196, 162, 101, 0.14) 0%, transparent 55%),
      var(--navy-deep);
  }

  .map__pin {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 76px;
    height: 76px;
    border: 1px solid rgba(196, 162, 101, 0.5);
    border-radius: 50%;
    color: var(--gold);
  }

  .map__pin svg {
    width: 32px;
    height: 32px;
  }

  .map__label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 900px) {
    .contacts {
      padding: 56px 0 64px;
    }

    .contacts__grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .contacts__form-wrap {
      padding: 32px 24px;
    }
  }
</style>
