---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';

const filters = ['Усі', 'Шеврони', 'Одяг', 'Аксесуари', 'Орнаменти'];

const works = [
  { src: '/images/work-5.png', title: 'Шеврон із тризубом', category: 'Шеврони' },
  { src: '/images/shop-1.png', title: 'Набір брендових нашивок', category: 'Шеврони' },
  { src: '/images/work-1.png', title: 'Кепка Mountain Expedition', category: 'Аксесуари' },
  { src: '/images/work-2.png', title: 'Логотип ГАПТА на льоні', category: 'Орнаменти' },
  { src: '/images/work-3.png', title: 'Патч Your Brand на поло', category: 'Одяг' },
  { src: '/images/work-4.png', title: 'Авторський орнамент', category: 'Орнаменти' },
  { src: '/images/shop-2.png', title: 'Вишивка на джинсовій куртці', category: 'Одяг' },
  { src: '/images/shop-3.png', title: 'Емблема на світшоті', category: 'Одяг' },
  { src: '/images/shop-4.png', title: 'Нашивки-прапорці', category: 'Шеврони' },
  { src: '/images/shop-5.png', title: 'Монограма на манжеті', category: 'Одяг' },
  { src: '/images/shop-6.png', title: 'Вишитий шопер', category: 'Аксесуари' },
];
---

<Layout
  title="Портфоліо — ГАПТА | Роботи студії машинної вишивки"
  description="Портфоліо студії ГАПТА: шеврони, вишивка на одязі та аксесуарах, авторські орнаменти. 11 обраних робіт із фільтром за категоріями — знайдіть натхнення для свого проєкту."
>
  <Header />
  <main>
    <PageHero
      image="/images/work-4.png"
      overline="Наші роботи"
      title="Портфоліо"
      crumb="Портфоліо"
    />

    <section class="portfolio-page">
      <div class="container">
        <div class="chips portfolio-page__filters" role="group" aria-label="Фільтр робіт за категоріями">
          {
            filters.map((f, i) => (
              <button
                type="button"
                class:list={['chip', { 'chip--active': i === 0 }]}
                data-filter={f === 'Усі' ? 'all' : f}
              >
                {f}
              </button>
            ))
          }
        </div>

        <div class="portfolio-page__grid">
          {
            works.map((w) => (
              <figure class="work-card" data-category={w.category}>
                <img src={w.src} alt={w.title} loading="lazy" />
                <figcaption class="work-card__overlay">
                  <span class="work-card__category">{w.category}</span>
                  <span class="work-card__title">{w.title}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>

        <div class="portfolio-page__cta">
          <div class="portfolio-page__cta-text">
            <p class="overline">Ваш проєкт — наступний</p>
            <h2 class="portfolio-page__cta-title">Сподобалась робота? Замовте свою вишивку</h2>
          </div>
          <a href="/order" class="btn btn--gold">
            Замовити вишивку
            <svg width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M0 6h16M11 1l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .portfolio-page {
    padding: 64px 0 88px;
  }

  .portfolio-page__filters {
    margin-bottom: 36px;
  }

  .portfolio-page__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .work-card {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    aspect-ratio: 1 / 1;
    background: var(--cream-dark);
  }

  .work-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .work-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding: 24px;
    background: linear-gradient(180deg, rgba(14, 23, 48, 0) 35%, rgba(14, 23, 48, 0.88) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .work-card:hover img {
    transform: scale(1.05);
  }

  .work-card:hover .work-card__overlay {
    opacity: 1;
  }

  .work-card__category {
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--gold);
  }

  .work-card__title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: #fff;
    line-height: 1.3;
  }

  .portfolio-page__cta {
    margin-top: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 40px 44px;
    background: var(--navy);
    border-radius: 2px;
  }

  .portfolio-page__cta-title {
    margin-top: 10px;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 600;
    color: #fff;
    line-height: 1.25;
  }

  @media (max-width: 900px) {
    .portfolio-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .portfolio-page {
      padding: 48px 0 64px;
    }

    .portfolio-page__grid {
      grid-template-columns: 1fr;
    }

    .portfolio-page__cta {
      flex-direction: column;
      align-items: flex-start;
      padding: 32px 24px;
    }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.remove('chip--active'));
      chip.classList.add('chip--active');
      const filter = chip.dataset.filter;
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>
