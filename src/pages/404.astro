---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Сторінку не знайдено | ГАПТА" description="Сторінку не знайдено. Поверніться на головну студії машинної вишивки ГАПТА.">
  <main style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--navy-deep); color: var(--cream); text-align: center; padding: 2rem;">
    <div>
      <p style="font-family: var(--font-serif); font-size: clamp(5rem, 15vw, 9rem); line-height: 1; color: var(--gold); margin-bottom: 1rem;">404</p>
      <h1 style="font-family: var(--font-serif); font-size: 2rem; margin-bottom: 1rem;">Сторінку не знайдено</h1>
      <p style="color: rgba(245, 240, 230, 0.7); margin-bottom: 2.5rem;">Такої сторінки не існує або вона була переміщена.</p>
      <a href="/" class="btn btn--gold">← На головну</a>
    </div>
  </main>
</Layout>
