---
const services = [
  { title: 'Шеврони та нашивки', icon: 'shield' },
  { title: 'Вишивка на одязі', icon: 'shirt' },
  { title: 'Брендована уніформа', icon: 'flower' },
  { title: 'Диджиталізація та розробка', icon: 'grid' },
  { title: 'Оптове виробництво', icon: 'clock' },
];
---

<section class="services" id="services">
  <div class="container">
    <div class="services__head">
      <h2 class="services__heading">НАШІ<br />ПОСЛУГИ</h2>
      <div class="services__cards">
        {
          services.map((s) => (
            <a href="#cta" class="service-card">
              {s.icon === 'shield' && (
                <svg class="service-card__icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M20 4l12 4v10c0 8-5 14-12 18C13 32 8 26 8 18V8l12-4Z" stroke-linejoin="round" />
                  <path d="M14.5 19.5l4 4 7-8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {s.icon === 'shirt' && (
                <svg class="service-card__icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M14 5l-9 7 4 5 3-2v18h16V15l3 2 4-5-9-7a6 6 0 0 1-12 0Z" stroke-linejoin="round" />
                </svg>
              )}
              {s.icon === 'flower' && (
                <svg class="service-card__icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                  <circle cx="20" cy="20" r="3.4" />
                  <path d="M20 6c3 5 3 9.6 0 14-3-4.4-3-9 0-14Z" stroke-linejoin="round" />
                  <path d="M20 6c3 5 3 9.6 0 14-3-4.4-3-9 0-14Z" transform="rotate(72 20 20)" stroke-linejoin="round" />
                  <path d="M20 6c3 5 3 9.6 0 14-3-4.4-3-9 0-14Z" transform="rotate(144 20 20)" stroke-linejoin="round" />
                  <path d="M20 6c3 5 3 9.6 0 14-3-4.4-3-9 0-14Z" transform="rotate(216 20 20)" stroke-linejoin="round" />
                  <path d="M20 6c3 5 3 9.6 0 14-3-4.4-3-9 0-14Z" transform="rotate(288 20 20)" stroke-linejoin="round" />
                </svg>
              )}
              {s.icon === 'grid' && (
                <svg class="service-card__icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                  <rect x="6" y="6" width="12" height="12" rx="1" />
                  <rect x="22" y="6" width="12" height="12" rx="1" />
                  <rect x="6" y="22" width="12" height="12" rx="1" />
                  <rect x="22" y="22" width="5" height="5" rx="0.5" />
                  <path d="M31 22v12M22 31h12" stroke-linecap="round" />
                </svg>
              )}
              {s.icon === 'clock' && (
                <svg class="service-card__icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                  <circle cx="20" cy="20" r="14" />
                  <path d="M20 11v9l6 4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              <h3 class="service-card__title">{s.title}</h3>
            </a>
          ))
        }
      </div>
      <a href="/#services" class="services__link">
        Усі послуги
        <svg width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M0 6h16M11 1l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--cream);
    padding: 72px 0 80px;
    border-bottom: 1px solid var(--line);
  }

  .services__head {
    display: flex;
    align-items: center;
    gap: 48px;
  }

  .services__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.25;
    color: var(--navy);
    flex-shrink: 0;
    padding-right: 48px;
    border-right: 1px solid var(--line);
  }

  .services__cards {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    flex: 1;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    padding: 26px 12px 22px;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--line);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 30px rgba(20, 33, 61, 0.12);
    border-color: rgba(196, 162, 101, 0.6);
  }

  .service-card__icon {
    width: 42px;
    height: 42px;
    color: var(--gold);
  }

  .service-card__title {
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--navy);
  }

  .services__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--gold);
    transition: gap 0.2s ease;
  }

  .services__link:hover {
    gap: 16px;
  }

  @media (max-width: 1024px) {
    .services__head {
      flex-wrap: wrap;
    }

    .services__heading {
      border-right: none;
      padding-right: 0;
    }

    .services__cards {
      order: 3;
      width: 100%;
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .services__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
    }

    .services__cards {
      grid-template-columns: 1fr;
    }

    .service-card {
      flex-direction: row;
      text-align: left;
      padding: 18px 20px;
    }
  }
</style>
