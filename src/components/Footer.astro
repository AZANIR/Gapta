---
const serviceLinks = [
  'Шеврони та нашивки',
  'Вишивка на одязі',
  'Брендована уніформа',
  'Диджиталізація',
  'Оптове виробництво',
];

const infoLinks = [
  { label: 'Магазин', href: '/shop' },
  { label: 'Портфоліо', href: '/portfolio' },
  { label: 'Процес роботи', href: '/#stats' },
  { label: 'Матеріали та якість', href: '/#features' },
  { label: 'Про нас', href: '/#cta' },
];

interface Social {
  name: string;
  href?: string;
  icon: string;
  internal?: boolean;
  mailUser?: string;
  mailDomain?: string;
}

const socials: Social[] = [
  { name: 'Instagram', href: 'https://www.instagram.com/gapta.rv/', icon: 'instagram' },
  { name: 'Facebook', href: '/#', icon: 'facebook', internal: true },
  { name: 'Telegram', href: 'https://t.me/ksanamayska', icon: 'telegram' },
  { name: 'Email', icon: 'email', mailUser: 'ksanamayska', mailDomain: 'gmail.com' },
];
---

<footer class="footer" id="contacts">
  <div class="container footer__grid">
    <div class="footer__col footer__col--brand">
      <a href="/" class="footer__brand">
        <span class="footer__logo">ГАПТА</span>
        <span class="footer__tagline">СТУДІЯ МАШИННОЇ<br />ВИШИВКИ</span>
      </a>
      <div class="footer__socials">
        {
          socials.map((s) => (
            <a
              href={s.mailUser ? '#' : s.href}
              class="footer__social"
              aria-label={s.name}
              target={s.internal || s.mailUser ? undefined : '_blank'}
              rel="noopener"
              {...(s.mailUser ? { 'data-mail-user': s.mailUser, 'data-mail-domain': s.mailDomain } : {})}
            >
              {s.icon === 'instagram' && (
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
                  <rect x="2" y="2" width="16" height="16" rx="4.5" />
                  <circle cx="10" cy="10" r="3.8" />
                  <circle cx="14.6" cy="5.4" r="0.9" fill="currentColor" stroke="none" />
                </svg>
              )}
              {s.icon === 'facebook' && (
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
                  <path d="M12.5 3.5h-2a3 3 0 0 0-3 3V9H5v3h2.5v5.5h3V12H13l.7-3h-3.2V6.7c0-.6.4-1 1-1h2V3.5Z" stroke-linejoin="round" />
                </svg>
              )}
              {s.icon === 'telegram' && (
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
                  <path d="M17.5 3.5L2.8 9.2c-.9.35-.8 1.6.2 1.85l3.7 1 1.4 4.3c.3.85 1.4 1 1.95.3l2.1-2.7 3.4 2.5c.7.5 1.7.15 1.9-.7l2.4-11.2c.2-1-.9-1.8-1.85-1.35Z" stroke-linejoin="round" />
                  <path d="M7.9 12.05l8-7.05" stroke-linecap="round" />
                </svg>
              )}
              {s.icon === 'email' && (
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3">
                  <rect x="2" y="4" width="16" height="12" rx="2" />
                  <path d="M2.5 5.5L10 11l7.5-5.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>

    <div class="footer__col">
      <h3 class="footer__heading">Послуги</h3>
      <ul class="footer__list">
        {serviceLinks.map((l) => <li><a href="/#services">{l}</a></li>)}
      </ul>
    </div>

    <div class="footer__col">
      <h3 class="footer__heading">Інформація</h3>
      <ul class="footer__list">
        {infoLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div class="footer__col">
      <h3 class="footer__heading">Контакти</h3>
      <ul class="footer__list footer__list--contacts">
        <li>
          <svg class="footer__contact-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2">
            <path d="M8 14.5S2.5 10 2.5 6.5a5.5 5.5 0 0 1 11 0C13.5 10 8 14.5 8 14.5Z" stroke-linejoin="round" />
            <circle cx="8" cy="6.5" r="2" />
          </svg>
          <span>м. Рівне, Україна</span>
        </li>
        <li>
          <svg class="footer__contact-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2">
            <path d="M3 13.5V6.5L8 2.5l5 4v7M6.5 13.5v-4h3v4" stroke-linejoin="round" />
          </svg>
          <span>вул. Котляревського, 2а</span>
        </li>
        <li>
          <svg class="footer__contact-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2">
            <path d="M3.5 2.5h3l1.2 3.2-1.8 1.4a9.8 9.8 0 0 0 4 4l1.4-1.8 3.2 1.2v3a1.5 1.5 0 0 1-1.6 1.5C6.4 14.6 1.4 9.6 1 3.9a1.5 1.5 0 0 1 1.5-1.4Z" stroke-linejoin="round" />
          </svg>
          <a href="tel:+380679079980">+38 (067) 907 99 80</a>
        </li>
        <li>
          <svg class="footer__contact-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2">
            <path d="M3.5 2.5h3l1.2 3.2-1.8 1.4a9.8 9.8 0 0 0 4 4l1.4-1.8 3.2 1.2v3a1.5 1.5 0 0 1-1.6 1.5C6.4 14.6 1.4 9.6 1 3.9a1.5 1.5 0 0 1 1.5-1.4Z" stroke-linejoin="round" />
          </svg>
          <a href="tel:+380932876080">+38 (093) 287 60 80</a>
        </li>
        <li>
          <svg class="footer__contact-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2">
            <circle cx="8" cy="8" r="6.5" />
            <path d="M1.5 8h13M8 1.5c1.8 1.7 2.7 4 2.7 6.5S9.8 12.8 8 14.5c-1.8-1.7-2.7-4-2.7-6.5S6.2 3.2 8 1.5Z" />
          </svg>
          <a href="https://gapta.com.ua" target="_blank" rel="noopener">gapta.com.ua</a>
        </li>
      </ul>
    </div>

    <div class="footer__col">
      <h3 class="footer__heading">Працюємо</h3>
      <ul class="footer__list footer__list--hours">
        <li><span class="footer__day">Пн–Пт:</span> 9:00 – 18:00</li>
        <li><span class="footer__day">Сб:</span> за домовленістю</li>
        <li><span class="footer__day">Нд:</span> вихідний</li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>© 2025 ГАПТА. Усі права захищено.</p>
      <a href="#privacy" class="footer__privacy">Політика конфіденційності</a>
    </div>
  </div>
</footer>

<script>
  // Email obfuscation: assemble mailto: links at runtime so bots can't harvest the address from HTML.
  document.querySelectorAll('[data-mail-user]').forEach((el) => {
    el.setAttribute('href', `mailto:${el.getAttribute('data-mail-user')}@${el.getAttribute('data-mail-domain')}`);
  });
</script>

<style>
  .footer {
    background: var(--navy-deep);
    color: rgba(255, 255, 255, 0.78);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr 1fr;
    gap: 48px;
    padding-top: 72px;
    padding-bottom: 64px;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 26px;
  }

  .footer__logo {
    font-family: var(--font-serif);
    font-size: 1.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1;
  }

  .footer__tagline {
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.45;
    border-left: 1px solid rgba(255, 255, 255, 0.15);
    padding-left: 14px;
  }

  .footer__socials {
    display: flex;
    gap: 12px;
  }

  .footer__social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.75);
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .footer__social svg {
    width: 17px;
    height: 17px;
  }

  .footer__social:hover {
    color: var(--navy-deep);
    background: var(--gold);
    border-color: var(--gold);
  }

  .footer__heading {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gold);
    margin-bottom: 22px;
  }

  .footer__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 0.86rem;
  }

  .footer__list a {
    transition: color 0.2s ease;
  }

  .footer__list a:hover {
    color: var(--gold);
  }

  .footer__list--contacts li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer__contact-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    color: var(--gold);
  }

  .footer__day {
    color: rgba(255, 255, 255, 0.95);
    font-weight: 600;
  }

  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 22px;
    padding-bottom: 22px;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .footer__privacy {
    transition: color 0.2s ease;
  }

  .footer__privacy:hover {
    color: var(--gold);
  }

  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }

    .footer__col--brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-top: 56px;
      padding-bottom: 48px;
    }

    .footer__bottom-inner {
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }
  }
</style>
