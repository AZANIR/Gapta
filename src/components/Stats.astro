---
const stats = [
  { value: '500+', label: 'брендів', icon: 'medal' },
  { value: '5/5', label: 'середня оцінка клієнтів', icon: 'people' },
  { value: '10+', label: 'років досвіду', icon: 'calendar' },
  { value: '100%', label: 'контроль якості на всіх етапах', icon: 'cube' },
];
---

<section class="stats" id="stats">
  <div class="container stats__inner">
    <div class="stats__lead">
      <h2 class="stats__heading">НАМ<br />ДОВІРЯЮТЬ</h2>
      <svg class="stats__needle" viewBox="0 0 40 12" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M2 6h30" stroke-linecap="round" />
        <circle cx="36" cy="6" r="2.4" />
      </svg>
    </div>

    <div class="stats__grid">
      {
        stats.map((s) => (
          <div class="stat">
            {s.icon === 'medal' && (
              <svg class="stat__icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                <circle cx="20" cy="15" r="9" />
                <circle cx="20" cy="15" r="4.5" />
                <path d="M14.5 22.5L11 35l6-3.5M25.5 22.5L29 35l-6-3.5" stroke-linejoin="round" />
                <path d="M20 11l1.2 2.4 2.6.4-1.9 1.9.5 2.6-2.4-1.3-2.4 1.3.5-2.6-1.9-1.9 2.6-.4L20 11Z" stroke-linejoin="round" />
              </svg>
            )}
            {s.icon === 'people' && (
              <svg class="stat__icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                <circle cx="14" cy="14" r="5" />
                <circle cx="27" cy="16" r="4" />
                <path d="M5 32c0-5 4-9 9-9s9 4 9 9" stroke-linecap="round" />
                <path d="M25 24c4 .6 8 4 8 8" stroke-linecap="round" />
              </svg>
            )}
            {s.icon === 'calendar' && (
              <svg class="stat__icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                <rect x="6" y="8" width="28" height="26" rx="2" />
                <path d="M6 15h28M13 4v7M27 4v7" stroke-linecap="round" />
                <circle cx="25" cy="25" r="6" />
                <path d="M25 21.5V25l2.5 1.8" stroke-linecap="round" />
              </svg>
            )}
            {s.icon === 'cube' && (
              <svg class="stat__icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
                <path d="M20 5l13 7.5v15L20 35 7 27.5v-15L20 5Z" stroke-linejoin="round" />
                <path d="M7 12.5L20 20l13-7.5M20 20v15" stroke-linejoin="round" />
                <path d="M14.5 25.5l3.5 3.5 7-7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            <div class="stat__text">
              <span class="stat__value">{s.value}</span>
              <span class="stat__label">{s.label}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stats {
    background: var(--cream-dark);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .stats__inner {
    display: flex;
    align-items: center;
    gap: 56px;
    padding-top: 48px;
    padding-bottom: 48px;
  }

  .stats__lead {
    flex-shrink: 0;
    padding-right: 56px;
    border-right: 1px solid var(--line);
  }

  .stats__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.3;
    color: var(--navy);
    margin-bottom: 12px;
  }

  .stats__needle {
    width: 40px;
    color: var(--gold);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 36px;
    flex: 1;
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .stat:not(:last-child) {
    border-right: 1px solid var(--line);
    padding-right: 36px;
  }

  .stat__icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    color: var(--gold);
  }

  .stat__value {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.7rem;
    font-weight: 500;
    color: var(--navy);
    line-height: 1.15;
  }

  .stat__label {
    display: block;
    font-size: 0.76rem;
    color: var(--muted);
    line-height: 1.4;
  }

  @media (max-width: 1024px) {
    .stats__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }

    .stats__lead {
      border-right: none;
      padding-right: 0;
    }

    .stats__grid {
      width: 100%;
      grid-template-columns: repeat(2, 1fr);
    }

    .stat:nth-child(2) {
      border-right: none;
      padding-right: 0;
    }
  }

  @media (max-width: 560px) {
    .stats__grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .stat:not(:last-child) {
      border-right: none;
      padding-right: 0;
      border-bottom: 1px solid var(--line);
      padding-bottom: 22px;
    }
  }
</style>
