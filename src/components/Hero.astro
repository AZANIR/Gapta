---
---

<section class="hero" id="hero">
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="overline hero__overline">Точна вишивка для сильних брендів</p>
      <div class="hero__rule" aria-hidden="true">
        <span class="hero__rule-line"></span>
        <svg class="hero__rule-diamond" width="10" height="10" viewBox="0 0 10 10" fill="none">
          <rect x="2.1" y="2.1" width="5.8" height="5.8" transform="rotate(45 5 5)" stroke="currentColor" stroke-width="1" />
        </svg>
        <span class="hero__rule-line"></span>
      </div>
      <h1 class="hero__title">Ідентичність бренду, втілена у тканині</h1>
      <p class="hero__subtitle">
        Створюємо шеврони, нашивки та вишивку на одязі й аксесуарах
        з увагою до кожної деталі.
      </p>
      <div class="hero__actions">
        <a href="/order" class="btn btn--navy">
          Замовити вишивку
          <svg width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M0 6h16M11 1l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="/portfolio" class="btn btn--outline">Переглянути портфоліо</a>
      </div>
    </div>
  </div>

  <a href="#features" class="stamp" aria-label="Якість у деталях — ГАПТА">
    <svg class="stamp__svg" viewBox="0 0 160 160" fill="none">
      <circle class="stamp__ring" cx="80" cy="80" r="78" stroke="currentColor" stroke-width="1" />
      <circle class="stamp__ring" cx="80" cy="80" r="56" stroke="currentColor" stroke-width="1" opacity="0.5" />
      <g class="stamp__spin">
        <defs>
          <path id="stamp-circle" d="M 80,80 m -66,0 a 66,66 0 1,1 132,0 a 66,66 0 1,1 -132,0" />
        </defs>
        <text class="stamp__text">
          <textPath href="#stamp-circle" startOffset="0">
            Якість у деталях • Гапта •&#160;
          </textPath>
        </text>
      </g>
      <g class="stamp__flower" stroke="currentColor" stroke-width="1.2">
        <circle cx="80" cy="80" r="5" fill="none" />
        <path d="M80 68c2.2 4.2 2.2 8.2 0 12-2.2-3.8-2.2-7.8 0-12Z" />
        <path d="M80 68c2.2 4.2 2.2 8.2 0 12-2.2-3.8-2.2-7.8 0-12Z" transform="rotate(45 80 80)" />
        <path d="M80 68c2.2 4.2 2.2 8.2 0 12-2.2-3.8-2.2-7.8 0-12Z" transform="rotate(90 80 80)" />
        <path d="M80 68c2.2 4.2 2.2 8.2 0 12-2.2-3.8-2.2-7.8 0-12Z" transform="rotate(135 80 80)" />
        <path d="M80 68c2.2 4.2 2.2 8.2 0 12-2.2-3.8-2.2-7.8 0-12Z" transform="rotate(180 80 80)" />
        <path d="M80 68c2.2 4.2 2.2 8.2 0 12-2.2-3.8-2.2-7.8 0-12Z" transform="rotate(225 80 80)" />
        <path d="M80 68c2.2 4.2 2.2 8.2 0 12-2.2-3.8-2.2-7.8 0-12Z" transform="rotate(270 80 80)" />
        <path d="M80 68c2.2 4.2 2.2 8.2 0 12-2.2-3.8-2.2-7.8 0-12Z" transform="rotate(315 80 80)" />
      </g>
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    background-image: url('/images/hero-bg.png');
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
    min-height: min(86vh, 760px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(245, 240, 230, 0.96) 0%,
      rgba(245, 240, 230, 0.85) 30%,
      rgba(245, 240, 230, 0.35) 58%,
      rgba(245, 240, 230, 0) 78%
    );
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: 64px;
    padding-bottom: 64px;
  }

  .hero__content {
    max-width: 620px;
  }

  .hero__rule {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--gold);
    margin: 18px 0 34px;
  }

  .hero__rule-line {
    display: block;
    width: 44px;
    height: 1px;
    background: var(--gold);
    opacity: 0.7;
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
    font-weight: 500;
    line-height: 1.12;
    color: var(--navy);
    margin-bottom: 26px;
  }

  .hero__subtitle {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--ink);
    max-width: 460px;
    margin-bottom: 40px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .stamp {
    position: absolute;
    z-index: 2;
    right: clamp(24px, 6vw, 96px);
    bottom: clamp(24px, 5vw, 56px);
    width: clamp(110px, 12vw, 150px);
    height: clamp(110px, 12vw, 150px);
    color: var(--gold);
    filter: drop-shadow(0 6px 18px rgba(14, 23, 48, 0.18));
    transition: transform 0.3s ease;
  }

  .stamp:hover {
    transform: scale(1.05);
  }

  .stamp__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .stamp__text {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    fill: var(--gold);
  }

  .stamp__spin {
    transform-origin: 80px 80px;
    animation: stamp-rotate 18s linear infinite;
  }

  .stamp__flower {
    color: var(--gold);
  }

  @keyframes stamp-rotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: auto;
      background-position: 68% center;
    }

    .hero__overlay {
      background: linear-gradient(
        180deg,
        rgba(245, 240, 230, 0.92) 0%,
        rgba(245, 240, 230, 0.85) 60%,
        rgba(245, 240, 230, 0.7) 100%
      );
    }

    .hero__inner {
      padding-top: 56px;
      padding-bottom: 150px;
    }

    .stamp {
      right: 20px;
      bottom: 20px;
    }
  }
</style>
