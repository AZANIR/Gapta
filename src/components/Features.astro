---
const features = [
  {
    title: 'Точність',
    text: 'до 0,1 мм',
    icon: 'target',
  },
  {
    title: 'Преміальні матеріали',
    text: 'нитки та тканини',
    icon: 'thread',
  },
  {
    title: 'Від 1–3 днів',
    text: 'виготовлення та доставка',
    icon: 'box',
  },
];
---

<section class="features" id="features">
  <div class="container features__grid">
    {
      features.map((f) => (
        <div class="feature">
          {f.icon === 'target' && (
            <svg class="feature__icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
              <circle cx="20" cy="20" r="14" />
              <circle cx="20" cy="20" r="8" />
              <circle cx="20" cy="20" r="2.4" />
              <path d="M20 2v5M20 33v5M2 20h5M33 20h5" stroke-linecap="round" />
            </svg>
          )}
          {f.icon === 'thread' && (
            <svg class="feature__icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M13 8h14v24H13z" stroke-linejoin="round" />
              <path d="M13 13h14M13 19h14M13 25h14" />
              <path d="M10 8h20M10 32h20" stroke-linecap="round" />
              <path d="M27 32c4 0 6 2 6 5" stroke-linecap="round" />
            </svg>
          )}
          {f.icon === 'box' && (
            <svg class="feature__icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M20 5l13 7.5v15L20 35 7 27.5v-15L20 5Z" stroke-linejoin="round" />
              <path d="M7 12.5L20 20l13-7.5M20 20v15" stroke-linejoin="round" />
            </svg>
          )}
          <div class="feature__text">
            <h3 class="feature__title">{f.title}</h3>
            <p class="feature__desc">{f.text}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .features {
    background: var(--cream);
    border-bottom: 1px solid var(--line);
  }

  .features__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    padding-top: 44px;
    padding-bottom: 44px;
  }

  .feature {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .feature:not(:last-child) {
    border-right: 1px solid var(--line);
    padding-right: 40px;
  }

  .feature__icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    color: var(--gold);
  }

  .feature__title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 2px;
  }

  .feature__desc {
    font-size: 0.82rem;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .features__grid {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .feature:not(:last-child) {
      border-right: none;
      padding-right: 0;
      border-bottom: 1px solid var(--line);
      padding-bottom: 26px;
    }
  }
</style>
