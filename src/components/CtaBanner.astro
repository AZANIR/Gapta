---

<section class="cta" id="cta">
  <div class="cta__side cta__side--left" aria-hidden="true"></div>
  <div class="cta__side cta__side--right" aria-hidden="true"></div>

  <div class="container cta__inner">
    <h2 class="cta__title">Готові створити щось особливе?</h2>
    <p class="cta__text">
      Розкажіть про свій проєкт — ми порадимо щодо якості, термінів
      та бездоганного результату.
    </p>
    <div class="cta__actions">
      <a href="/order" class="btn btn--gold">Отримати розрахунок</a>
      <a href="/contacts" class="cta__link">
        Зв'язатися з нами
        <svg width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M0 6h16M11 1l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    background: var(--navy-deep);
    overflow: hidden;
  }

  .cta__side {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 30%;
    background-size: cover;
    background-position: center;
    pointer-events: none;
  }

  .cta__side--left {
    left: 0;
    background-image: url('/images/cta-left.png');
    -webkit-mask-image: linear-gradient(90deg, #000 0%, transparent 100%);
    mask-image: linear-gradient(90deg, #000 0%, transparent 100%);
    opacity: 0.55;
  }

  .cta__side--right {
    right: 0;
    background-image: url('/images/cta-right.png');
    -webkit-mask-image: linear-gradient(-90deg, #000 0%, transparent 100%);
    mask-image: linear-gradient(-90deg, #000 0%, transparent 100%);
    opacity: 0.55;
  }

  .cta__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 92px;
    padding-bottom: 96px;
  }

  .cta__title {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3.6vw, 2.9rem);
    font-weight: 500;
    color: #fff;
    margin-bottom: 20px;
  }

  .cta__text {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.72);
    max-width: 520px;
    margin-bottom: 40px;
  }

  .cta__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px;
  }

  .cta__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #fff;
    transition: color 0.2s ease, gap 0.2s ease;
  }

  .cta__link:hover {
    color: var(--gold);
    gap: 16px;
  }

  @media (max-width: 760px) {
    .cta__side {
      width: 45%;
      opacity: 0.35;
    }

    .cta__inner {
      padding-top: 72px;
      padding-bottom: 76px;
    }

    .cta__actions {
      flex-direction: column;
      gap: 22px;
    }
  }
</style>
